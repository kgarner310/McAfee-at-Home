# McAfee at Home Configuration

# DNS Shield Settings
LISTEN_ADDR=0.0.0.0:53
UPSTREAM_DNS=8.8.8.8:53,1.1.1.1:53
CACHE_SIZE=10000

# Antivirus Settings
CLAMD_PORT=3310
MAX_SCAN_SIZE=104857600

# API Settings
FLASK_ENV=production
LOG_LEVEL=info

# Frontend Settings
REACT_APP_API_URL=http://localhost:8000
REACT_APP_DNS_STATS_API=http://localhost:8000/api/dns

# Optional: Authentication (for dashboard)
# API_KEY=your_secret_key_here
